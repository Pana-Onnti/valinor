    {
      "id": "text_ZOFsw8zzan",
      "type": "text",
      "x": -620,
      "y": 575,
      "width": 1160,
      "height": 80,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a180",
      "roundness": null,
      "seed": 1181,
      "version": 1,
      "versionNonce": 2181,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780508110777,
      "link": null,
      "locked": false,
      "text": "Legend / operating principle:\n1. Aulë is the deterministic business compiler, not another LLM agent.\n2. Ontology and graph are versioned artifacts.\n3. Reports, chatbot, and benchmark all consume the same Business Graph.\n4. Event Bus drives Memory Layer and Business Genome projections.\n5. Production target can be AWS while local dev remains Docker Compose.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Legend / operating principle:\n1. Aulë is the deterministic business compiler, not another LLM agent.\n2. Ontology and graph are versioned artifacts.\n3. Reports, chatbot, and benchmark all consume the same Business Graph.\n4. Event Bus drives Memory Layer and Business Genome projections.\n5. Production target can be AWS while local dev remains Docker Compose.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "text_3l3Kfs7Vs5",
      "type": "text",
      "x": 610,
      "y": 575,
      "width": 1320,
      "height": 80,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a181",
      "roundness": null,
      "seed": 1182,
      "version": 1,
      "versionNonce": 2182,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780508110777,
      "link": null,
      "locked": false,
      "text": "Migration path:\nPhase 1: Add artifact manifest + trace to existing /api/analyze.\nPhase 2: Promote ontology + graph to first-class artifacts.\nPhase 3: Add domain events and genome endpoint.\nPhase 4: Move reports/chat/benchmark to graph-grounded consumers.\nPhase 5: Optional AWS cutover: Cognito, ECS, RDS, ElastiCache, S3, CloudWatch.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Migration path:\nPhase 1: Add artifact manifest + trace to existing /api/analyze.\nPhase 2: Promote ontology + graph to first-class artifacts.\nPhase 3: Add domain events and genome endpoint.\nPhase 4: Move reports/chat/benchmark to graph-grounded consumers.\nPhase 5: Optional AWS cutover: Cognito, ECS, RDS, ElastiCache, S3, CloudWatch.",
      "autoResize": false,
      "lineHeight": 1.25
    }
